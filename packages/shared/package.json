{
  "name": "@morphe.us/shared",
  "version": "0.1.0",
  "description": "Shared utilities among packages",
  "exports": {
    "./chore": {
      "types": "./dist/chore/index.d.ts",
      "import": "./dist/chore/index.mjs",
      "require": "./dist/chore/index.js",
      "default": "./dist/chore/index.js"
    },
    "./queries": {
      "types": "./dist/queries/index.d.ts",
      "import": "./dist/queries/index.mjs",
      "require": "./dist/queries/index.js",
      "default": "./dist/queries/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.mjs",
      "require": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "publish": "npm publish --access public",
    "clean": "rm -rf dist"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.6.1"
}
